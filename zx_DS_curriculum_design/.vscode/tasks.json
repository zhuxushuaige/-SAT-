{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Create output directory",
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "if not exist output mkdir output"
                ]
            },
            "group": "build",
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "type": "shell",
            "label": "Compile Program",
            "command": "cmd",
            "args": [
                "/c",
                "g++ -std=c++17 -Iinclude -o output/main.exe src/main.cpp"
            ],
            "group": "build",
            "dependsOn": "Create output directory",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "type": "shell",
            "label": "Run Program",
            "command": "cmd",
            "args": [
                "/c",
                "output\\main.exe"
            ],
            "group": "test",
            "dependsOn": "Compile Program",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Build and Run in New Window",
            "command": "cmd",
            "args": [
                "/c",
                "if not exist output mkdir output && g++ -std=c++17 -Iinclude -o output/main.exe src/main.cpp && if %errorlevel%==0 (start \"X-Sudoku Program\" cmd /k \"echo Starting X-Sudoku Program... && output/main.exe\") else (echo Compilation failed && pause)"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Run in External Terminal",
            "command": "start",
            "args": [
                "cmd",
                "/k",
                "cd /d \"${workspaceFolder}\" && echo Starting X-Sudoku Program... && output\\main.exe"
            ],
            "group": "test",
            "dependsOn": "Compile Program",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Run with External Batch",
            "command": "run_external.bat",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\Users\\zhuxu\\Desktop\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "type": "shell",
            "label": "运行当前文件",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": false,
                "clear": true
            },
            "dependsOn": "C/C++: g++.exe 生成活动文件"
        }
    ]
}